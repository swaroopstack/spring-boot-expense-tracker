{
  "info": {
    "_postman_id": "a1b2c3d4-1111-4a2b-9c3d-000000000001",
    "name": "Personal Expense Tracker API",
    "description": "Collection to verify every endpoint of the Personal Expense Tracker REST API.\n\nStart the Spring Boot application first (mvn spring-boot:run) and make sure the baseUrl variable points to http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "expenseId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Add Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response contains the saved expense', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a('number');",
              "    pm.expect(body.title).to.eql('Lunch');",
              "    pm.expect(body.amount).to.eql(250.00);",
              "});",
              "",
              "pm.collectionVariables.set('expenseId', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Lunch\",\n    \"amount\": 250.00,\n    \"category\": \"Food\",\n    \"description\": \"Team lunch at office\",\n    \"date\": \"2026-11-10\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expenses"
          ]
        }
      }
    },
    {
      "name": "2. Get All Expenses",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expenses"
          ]
        }
      }
    },
    {
      "name": "3. Get Expense by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Expense id matches the request', function () {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('expenseId')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expenses",
            "{{expenseId}}"
          ]
        }
      }
    },
    {
      "name": "4. Update Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Expense is updated', function () {",
              "    pm.expect(pm.response.json().title).to.eql('Dinner');",
              "    pm.expect(pm.response.json().amount).to.eql(400.00);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Dinner\",\n    \"amount\": 400.00,\n    \"category\": \"Food\",\n    \"description\": \"Family dinner\",\n    \"date\": \"2026-11-11\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expenses",
            "{{expenseId}}"
          ]
        }
      }
    },
    {
      "name": "5. Get Total Expenses",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains total amount and count', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.totalAmount).to.be.a('number');",
              "    pm.expect(body.numberOfExpenses).to.be.a('number');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/expenses/total",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expenses",
            "total"
          ]
        }
      }
    },
    {
      "name": "6. Delete Expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expenses",
            "{{expenseId}}"
          ]
        }
      }
    },
    {
      "name": "7. Get Missing Expense (404 example)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Error body contains a helpful message', function () {",
              "    pm.expect(pm.response.json().message).to.include('Expense not found with id');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/expenses/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expenses",
            "9999"
          ]
        }
      }
    }
  ]
}
